# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty or set to auto to use zero-config embedded MongoDB Memory Server for local dev)
# For production, obtain a free MongoDB Atlas URI: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb://localhost:27017/jobpilot

# JWT Secret
JWT_SECRET=jobpilot_super_secure_jwt_secret_change_in_production_2025
JWT_EXPIRES_IN=7d

# File Uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# Cron Schedule (Every 6 hours by default: 0 */6 * * *)
JOB_SYNC_CRON="0 */6 * * *"
ENABLE_CRON_SYNC=true

# Job Ingestion Settings
MAX_JOBS_PER_SOURCE=50

# Client Environment (client/.env)
# VITE_API_BASE_URL=http://localhost:5000/api
